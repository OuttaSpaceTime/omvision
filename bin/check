#!/usr/bin/env bash
# Everything a change should pass, in one command. Offscreen, never touches
# ~/Notes, never opens a window.
#
#   bin/check                   all four steps
#   bin/check lint px           only those steps (any of: lint px load test)
#   bin/check -v                print each step's full output
#   bin/check --update-baseline rewrite .qmllint-baseline from today's
#                               warnings (after fixing some, or on purpose)
#
# Steps:
#   lint  qmllint over every .qml file git knows or would add, failing only
#         on warnings that are not in .qmllint-baseline.
#   px    no typed pixel numbers on geometry properties outside Theme.qml
#         The rule and its opt-out marker: "px" below, or docs/testing.md.
#   load  the app starts offscreen against a throwaway HOME seeded from
#         tests/fixtures/home, and logs no QML warning or error.
#   test  bin/test, both layers.
#
# Every step runs even when an earlier one failed, so one run shows
# everything that is wrong. Exits non-zero if any step failed.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
QMLLINT=/usr/lib/qt6/bin/qmllint
BASELINE="$ROOT/.qmllint-baseline"
LOAD_SECONDS="${OMVISION_CHECK_LOAD_SECONDS:-10}"

verbose=0 update=0
steps=()
for a in "$@"; do
  case "$a" in
    -v) verbose=1 ;;
    --update-baseline) update=1 ;;
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    lint|px|load|test) steps+=("$a") ;;
    *) echo "bin/check: unknown step '$a' (lint, px, load, test)" >&2; exit 2 ;;
  esac
done
# Rewriting the baseline is a lint run and nothing else.
if [ "$update" = 1 ]; then steps=(lint); fi
[ "${#steps[@]}" -gt 0 ] || steps=(lint px load test)

scratch="$(mktemp -d "${TMPDIR:-/tmp}/omvision-check.XXXXXX")"
trap 'rm -rf -- "$scratch"' EXIT

failed=0
summary=()
note() { summary+=("$(printf '%-6s %s' "$1" "$2")"); }

# The QML files to check: everything tracked, plus new files not yet added
# (so a file is checked before its first commit), minus anything git
# ignores. .claude/ is skipped by name as well: agent worktrees live there,
# each a whole second copy of the app.
qml_files() {
  git -C "$ROOT" ls-files --cached --others --exclude-standard -- '*.qml' \
    | grep -v '^\.claude/' | sort -u \
    | while IFS= read -r f; do [ -f "$ROOT/$f" ] && printf '%s\n' "$f"; done
}

# ---- lint --------------------------------------------------------------------
# qmllint can't see the app the way Quickshell does. Quickshell synthesizes a
# qmldir for the config directory, which is what makes `pragma Singleton`
# files (Theme.qml, Paths.qml) singletons; qmllint only reads a real qmldir,
# so on the repo as it stands it sees Theme as an ordinary type and reports
# every `Theme.foo` as a missing property -- about 770 warnings of noise, and
# a real typo like `Theme.spaceXxl` hidden among them. A qmldir can't be
# committed to fix that: a hand-written one switches Quickshell's own off.
#
# So the linter runs on a copy: every .qml and .js file copied into a temp
# dir with the same layout, plus a qmldir there that declares the singletons
# and nothing else (the directory's other types still resolve implicitly).
# With it, Theme resolves and a misspelled token is a real warning again.
# Silencing [missing-property], [unqualified] or [import] outright was the
# other option, and each of those would hide real bugs: a misspelled
# property, a misspelled id, a misspelled import.
#
# What qmllint still reports on today's code (delegates reaching outer ids
# without `pragma ComponentBehavior: Bound`, a few properties typed too
# loosely, Quickshell's Process.exited having a C++ enum qmllint can't see,
# and the MarkdownHighlight plugin, which ships no type info) is recorded in
# .qmllint-baseline, and only a warning not in it fails the check. The
# baseline keys each warning by file, category, message and the text of its
# source line, not the line number, so edits elsewhere in a file don't turn
# old warnings into new ones. Identical entries are counted, so one more
# copy of a baselined warning still fails. The price: editing the very line
# a baselined warning sits on makes it "new" until it is fixed or the
# baseline is rewritten (bin/check --update-baseline), and fixing one copy
# while adding another elsewhere in the same file goes unnoticed. Both were
# judged better than keying on line numbers, which every edit above a
# warning would break.
#
# .qmllint.ini is copied along, so the copy is linted with the same levels a
# hand-run qmllint in the repo gets.
run_lint() {
  if [ ! -x "$QMLLINT" ]; then
    echo "bin/check: $QMLLINT not found (qt6-declarative)" >&2
    failed=1; note lint "not run: no qmllint"; return
  fi
  local shadow="$scratch/lint"
  mkdir -p "$shadow"
  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(qml_files)
  while IFS= read -r f; do
    mkdir -p "$shadow/$(dirname "$f")"
    cp "$ROOT/$f" "$shadow/$f"
  done < <(qml_files; git -C "$ROOT" ls-files --cached --others --exclude-standard -- '*.js' | grep -v '^\.claude/')
  [ -f "$ROOT/.qmllint.ini" ] && cp "$ROOT/.qmllint.ini" "$shadow/.qmllint.ini"
  for f in "$shadow"/*.qml; do
    if grep -q '^pragma Singleton' "$f"; then
      local name; name="$(basename "$f" .qml)"
      printf 'singleton %s 1.0 %s.qml\n' "$name" "$name" >>"$shadow/qmldir"
    fi
  done

  (cd "$shadow" && "$QMLLINT" --json "$scratch/lint.json" "${files[@]}" >"$scratch/lint.txt" 2>&1)
  if [ ! -s "$scratch/lint.json" ]; then
    cat "$scratch/lint.txt"
    failed=1; note lint "qmllint wrote no report"; return
  fi
  [ "$verbose" = 1 ] && cat "$scratch/lint.txt"

  local out code
  out="$(python3 - "$scratch/lint.json" "$shadow" "$BASELINE" "$update" <<'PY'
import collections, json, os, sys
report, shadow, baseline_path, update = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1"

def key(rel, w):
    try:
        with open(os.path.join(shadow, rel), encoding="utf-8") as fh:
            src = fh.read().split("\n")[w.get("line", 0) - 1].strip() if w.get("line") else ""
    except (OSError, IndexError):
        src = ""
    return "\t".join((rel, w.get("id", "") or "", " ".join(w.get("message", "").split()), src))

found = collections.Counter()
where = {}
for f in json.load(open(report, encoding="utf-8"))["files"]:
    # qmllint names each file as it was given: relative to the copy.
    rel = os.path.normpath(os.path.relpath(f["filename"], shadow)
                           if os.path.isabs(f["filename"]) else f["filename"])
    for w in f["warnings"]:
        if w.get("type") == "info":
            continue
        k = key(rel, w)
        found[k] += 1
        where.setdefault(k, []).append(w)

header = """# qmllint warnings that existed when bin/check was introduced, one per line:
# file, category, message and the warning's source line, tab-separated.
# bin/check fails only on warnings that are not listed here. Fix one and
# drop its line (bin/check --update-baseline rewrites the whole file); never
# add a line by hand to get a new warning past the check.
"""
if update:
    with open(baseline_path, "w", encoding="utf-8") as fh:
        fh.write(header)
        for k in sorted(found.elements()):
            fh.write(k + "\n")
    print(f"wrote {sum(found.values())} warnings to {os.path.basename(baseline_path)}")
    print("SUMMARY baseline rewritten")
    sys.exit(0)

known = collections.Counter()
if os.path.exists(baseline_path):
    for line in open(baseline_path, encoding="utf-8"):
        line = line.rstrip("\n")
        if line and not line.startswith("#"):
            known[line] += 1

new = found - known
gone = known - found
for k in sorted(new):
    rel, wid, msg, src = k.split("\t")
    for w in where[k][known[k]:]:
        print(f"{rel}:{w.get('line', '?')}:{w.get('column', '?')}: {msg} [{wid}]")
        if src:
            print(f"    {src}")
if gone:
    print(f"note: {sum(gone.values())} baselined warnings are gone; "
          "bin/check --update-baseline drops them so they can't come back unnoticed")
n_new, n_old = sum(new.values()), sum((found & known).values())
print(f"SUMMARY {n_new} new warnings, {n_old} baselined")
sys.exit(1 if n_new else 0)
PY
)"
  code=$?
  printf '%s\n' "$out" | grep -v '^SUMMARY '
  local line; line="$(printf '%s\n' "$out" | sed -n 's/^SUMMARY //p')"
  if [ "$code" != 0 ]; then failed=1; note lint "FAILED: ${line:-qmllint report unreadable}"
  else note lint "ok: $line"; fi
}

# ---- px ----------------------------------------------------------------------
# "Never type a pixel number" (CLAUDE.md): sizes come from Theme.qml's tokens.
# Flags a numeric literal on a geometry property -- width, height, x, y,
# margins, spacing, padding, pixelSize, pointSize, radius, duration and the
# implicit/preferred/minimum/maximum sizes -- in any .qml file except
# Theme.qml (where the numbers are defined), ShotDriver.qml and tests/ (which
# are tooling, not UI).
#
# 0 is never flagged: it is the absence of a size, not a size. 1 is flagged
# like any other number, because on these properties it is one: a 1px rule
# or border has Theme.hairlineWidth and Theme.borderWidth. A number that is
# an operand of * or / is a ratio, not a size (`parent.width / 2`), and is
# not flagged either.
#
# A size that really must be typed takes a marker on the same line, with the
# reason: `width: 1440  // check: allow-px default window size`. A marker
# without a reason doesn't count.
#
# It reads one line at a time (a binding split over lines is checked on its
# first line only) and ignores strings and // comments.
run_px() {
  local out code
  qml_files >"$scratch/px-files"
  out="$(python3 - "$ROOT" "$scratch/px-files" <<'PY'
import os, re, sys
root, listing = sys.argv[1], sys.argv[2]
PROPS = (r"(?:width|height|x|y|margins|(?:left|right|top|bottom)Margin"
         r"|(?:horizontal|vertical)CenterOffset|spacing|(?:row|column)Spacing"
         r"|padding|(?:left|right|top|bottom|horizontal|vertical)Padding"
         r"|pixelSize|pointSize|radius|duration"
         r"|(?:implicit|preferred|minimum|maximum)(?:Width|Height))")
binding = re.compile(r"^\s*(?:[A-Za-z_]\w*\.)*(" + PROPS + r")\s*:(?!:)\s*(.*)$")
number = re.compile(r"(?<![\w.])(\d+(?:\.\d+)?)(?![\w.])")
marker = re.compile(r"//\s*check:\s*allow-px\s+\S")

def code_only(line):
    # The line with string contents blanked and any // comment cut off.
    out, quote, i = [], None, 0
    while i < len(line):
        c = line[i]
        if quote:
            if c == "\\":
                out.append("  "); i += 2; continue
            out.append(c if c == quote else " ")
            if c == quote:
                quote = None
        else:
            if line.startswith("//", i):
                break
            if c in "\"'`":
                quote = c
            out.append(c)
        i += 1
    return "".join(out)

hits = {}
for rel in open(listing, encoding="utf-8").read().split("\n"):
    if not rel:
        continue
    if rel == "Theme.qml" or rel == "ShotDriver.qml" or rel.startswith("tests/"):
        continue
    with open(os.path.join(root, rel), encoding="utf-8") as fh:
        for n, raw in enumerate(fh, 1):
            if marker.search(raw):
                continue
            for part in re.split(r"[;{]", code_only(raw.rstrip("\n"))):
                m = binding.match(part)
                if not m:
                    continue
                expr = m.group(2)
                for num in number.finditer(expr):
                    if float(num.group(1)) == 0:
                        continue
                    before = expr[:num.start()].rstrip()[-1:]
                    after = expr[num.end():].lstrip()[:1]
                    if before in ("*", "/") or after in ("*", "/"):
                        continue
                    hits.setdefault(rel, []).append(f"{rel}:{n}: {m.group(1)}: {num.group(1)}    {raw.strip()}")
for rel in sorted(hits):
    for h in hits[rel]:
        print(h)
total = sum(len(v) for v in hits.values())
if total:
    print("by file: " + ", ".join(f"{r} {len(v)}" for r, v in sorted(hits.items())))
print(f"SUMMARY {total} typed pixel numbers" + (f" in {len(hits)} files" if hits else ""))
sys.exit(1 if total else 0)
PY
)"
  code=$?
  printf '%s\n' "$out" | grep -v '^SUMMARY '
  local line; line="$(printf '%s\n' "$out" | sed -n 's/^SUMMARY //p')"
  if [ "$code" != 0 ]; then failed=1; note px "FAILED: ${line:-check did not run}"
  else note px "ok: $line"; fi
}

# ---- load --------------------------------------------------------------------
# The app, started the way bin/test starts it (bin/omvision, offscreen, a
# temp HOME seeded by tests/app/seed-home.sh, so the real ~/Notes is never
# read), left running for LOAD_SECONDS and then stopped by `timeout`. Any
# QML warning or error it logs fails the step. Only what loads at startup
# is covered: a dialog or screen behind a Loader that hasn't been opened
# yet is bin/test's job.
#
# Quickshell's own notices about running offscreen under Wayland are
# expected (bin/shot drops the same lines) and are not QML problems.
# WAYLAND_DISPLAY stays set: qs's GTK setup aborts without a display, and
# offscreen nothing is ever shown on it.
run_load() {
  if ! command -v qs >/dev/null; then
    echo "bin/check: qs (Quickshell) not found" >&2
    failed=1; note load "not run: no qs"; return
  fi
  local home="$scratch/home"
  mkdir -p "$home"
  touch "$home/.omvision-test-home"
  if ! "$ROOT/tests/app/seed-home.sh" "$ROOT/tests/fixtures/home" "$home" >/dev/null; then
    failed=1; note load "FAILED: couldn't seed the temp HOME"; return
  fi

  env -u OMVISION_TEST -u OMVISION_SHOT_DIR -u OMVISION_SHOT_WIDTH -u OMVISION_SHOT_HEIGHT \
    HOME="$home" QT_QPA_PLATFORM=offscreen \
    timeout "$LOAD_SECONDS" "$ROOT/bin/omvision" --no-color >"$scratch/load.log" 2>&1
  local code=$?
  [ "$verbose" = 1 ] && cat "$scratch/load.log"

  local problems
  problems="$(grep -E 'WARN|ERROR|CRIT|FATAL|[Ee]rror:|qrc:|file://' "$scratch/load.log" \
    | grep -vE 'WAYLAND_DISPLAY is present|actually running wayland|--- WARNING ---|window masks' || true)"
  if [ -n "$problems" ]; then
    printf '%s\n' "$problems"
    failed=1; note load "FAILED: $(printf '%s\n' "$problems" | wc -l) warning/error lines"
  elif [ "$code" != 124 ]; then
    tail -20 "$scratch/load.log"
    failed=1; note load "FAILED: the app exited ($code) before ${LOAD_SECONDS}s were up"
  else
    note load "ok: ran ${LOAD_SECONDS}s offscreen, no QML warnings"
  fi
}

# ---- test --------------------------------------------------------------------
run_test() {
  local args=()
  [ "$verbose" = 1 ] && args+=(-v)
  if "$ROOT/bin/test" "${args[@]}"; then note test "ok: bin/test passed"
  else failed=1; note test "FAILED: see bin/test's output above"; fi
}

for s in "${steps[@]}"; do
  echo "== $s"
  "run_$s"
  echo
done

printf '%s\n' "${summary[@]}"
if [ "$failed" = 0 ]; then echo "all passed"; else echo "FAILED"; fi
exit "$failed"
